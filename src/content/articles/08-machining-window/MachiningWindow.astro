---
// MachiningWindow.astro
---

<div id="machining-container" class="w-full h-[48rem] overflow-hidden" style="background: transparent;">
</div>

<!-- Slider groups will be dynamically inserted here -->
<div id="slider-container" class="flex flex-wrap justify-center gap-x-10 gap-y-4 mt-4">
</div>

<p class="mt-5 text-center text-sm text-gray-600 dark:text-gray-400">
    All axes and parameters are <strong class="font-semibold">normalized</strong>: every value runs from 0 to 1
    and carries no unit. What the model shows is the <em>shape</em> of the machining window &mdash; which limit
    bounds it where, and how it deforms as you move a limit &mdash; not a set of numbers to dial into a machine.
</p>

<script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { SliderGenerator } from './SliderGenerator.ts';
    import { CSG } from 'three-csg-ts';

    const objects: THREE.Object3D[] = [];
    
    let bhmin = 0.2;
    let bhmax = 0.7;
    let T = 1;
    let vb = 0.4;
    let p = 0.4;
    let q = 0.1;
    let m = 0.25;
    let n = 0.45;
    let CTVB = 0.8;
    let P = 6;
    let ks11 = 1200;
    let z_kienzle = 0.5;
    let vmin = 0.6;
    let vmax = 0.9;
    let hmin = 0.1;
    let hmax = 0.6;
    let bmin = 0.1;
    let bmax = 0.9;

    function initMachiningWindow() {
        const container = document.getElementById('machining-container');
        const sliderContainer = document.getElementById('slider-container');
        if (!container || !sliderContainer) return;
        
        // Theme detection functions
        const isDarkTheme = () => document.documentElement.classList.contains('dark');
        const getThemeColors = () => {
            const dark = isDarkTheme();
            return {
                grid: dark ? 0x444444 : 0xcccccc,
                gridHelper: dark ? 0x666666 : 0xcccccc,
                axis: dark ? 0xaaaaaa : 0x999999
            };
        };
        
        // Colors identifying which constraint is active on each surface of the
        // machining window (categorical palette, separate steps per theme)
        const LIMIT_COLORS = {
            taylor: { label: 'Tool life (Taylor)',            light: '#2a78d6', dark: '#3987e5' },
            kienzle: { label: 'Machine power (Kienzle)',      light: '#008300', dark: '#008300' },
            v: { label: 'Cutting speed (v min / v max)',      light: '#e87ba4', dark: '#d55181' },
            h: { label: 'Chip thickness (h min / h max)',     light: '#eda100', dark: '#c98500' },
            b: { label: 'Width of cut (b min / b max)',       light: '#1baf7a', dark: '#199e70' },
            bh: { label: 'Chip slenderness (b/h)',            light: '#eb6834', dark: '#d95926' },
        } as const;
        type LimitName = keyof typeof LIMIT_COLORS;
        const limitColor = (name: LimitName) => LIMIT_COLORS[name][isDarkTheme() ? 'dark' : 'light'];

        // Initialize slider generator
        const sliderGen = new SliderGenerator();
        
        // Create sliders using the generator
        const bhminSlider = sliderGen.createSlider({
            name: 'bhmin',
            min: 0.01,
            max: 0.99,
            step: 0.01,
            defaultValue: bhmin,
            displayPrecision: 2,
            label: 'b/h min',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                bhmin = value;
                requestGenerate();
            }
        });
        
        const bhmaxSlider = sliderGen.createSlider({
            name: 'bhmax',
            min: 0.01,
            max: 0.99,
            step: 0.01,
            defaultValue: bhmax,
            displayPrecision: 2,
            label: 'b/h max',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                bhmax = value;
                requestGenerate();
            }
        });
        const vminSlider = sliderGen.createSlider({
            name: 'vmin',
            min: 0.01,
            max: 2,
            step: 0.01,
            defaultValue: vmin,
            displayPrecision: 2,
            label: 'v min',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
            vmin = value;
            requestGenerate();
            }
        });

        const vmaxSlider = sliderGen.createSlider({
            name: 'vmax',
            min: 0.01,
            max: 2,
            step: 0.01,
            defaultValue: 0.9,
            displayPrecision: 2,
            label: 'v max',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
            vmax = value;
            requestGenerate();
            }
        });

        const hminSlider = sliderGen.createSlider({
            name: 'hmin',
            min: 0.01,
            max: 1,
            step: 0.01,
            defaultValue: hmin,
            displayPrecision: 2,
            label: 'h min',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                hmin = value;
                requestGenerate();
            }
        });

        const hmaxSlider = sliderGen.createSlider({
            name: 'hmax',
            min: 0.01,
            max: 1,
            step: 0.01,
            defaultValue: hmax,
            displayPrecision: 2,
            label: 'h max',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                hmax = value;
                requestGenerate();
            }
        });

        const bminSlider = sliderGen.createSlider({
            name: 'bmin',
            min: 0.01,
            max: 1,
            step: 0.01,
            defaultValue: bmin,
            displayPrecision: 2,
            label: 'b min',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                bmin = value;
                requestGenerate();
            }
        });

        const bmaxSlider = sliderGen.createSlider({
            name: 'bmax',
            min: 0.01,
            max: 1,
            step: 0.01,
            defaultValue: bmax,
            displayPrecision: 2,
            label: 'b max',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                bmax = value;
                requestGenerate();
            }
        });

        const zkienzleSlider = sliderGen.createSlider({
            name: 'z_kienzle',
            min: 0.01,
            max: 1,
            step: 0.01,
            defaultValue: z_kienzle,
            displayPrecision: 2,
            label: 'z Kienzle',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                z_kienzle = value;
                requestGenerate();
            }
        });

        const PSlider = sliderGen.createSlider({
            name: 'P',
            min: 1,
            max: 10,
            step: 0.1,
            defaultValue: P,
            displayPrecision: 2,
            label: 'P',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                P = value;
                requestGenerate();
            }
        });

        const TSlider = sliderGen.createSlider({
            name: 'T',
            min: 0.01,
            max: 2,
            step: 0.01,
            defaultValue: T,
            displayPrecision: 2,
            label: 'T',
            containerClass: 'flex flex-col',
            onUpdate: (value) => {
                T = value;
                requestGenerate();
            }
        });
        // Group the sliders into vertical columns
        const addSliderGroup = (title: string, sliders: { container: HTMLDivElement }[]) => {
            const group = document.createElement('div');
            group.className = 'flex flex-col gap-2';
            const heading = document.createElement('span');
            heading.className = 'text-sm font-semibold';
            heading.textContent = title;
            group.appendChild(heading);
            for (const slider of sliders) {
                group.appendChild(slider.container);
            }
            sliderContainer.appendChild(group);
        };
        addSliderGroup('Machine', [PSlider, zkienzleSlider]);
        addSliderGroup('Tool', [TSlider, vminSlider, vmaxSlider]);
        addSliderGroup('Chip', [hminSlider, hmaxSlider, bminSlider, bmaxSlider, bhminSlider, bhmaxSlider]);
        
        // Scene setup (keeping your existing Three.js code)
        const scene = new THREE.Scene();
        // Remove background to make it transparent
        scene.background = null;
        
        // Camera setup
        const aspect = container.clientWidth / container.clientHeight;
        const frustumSize = 2;
        const camera = new THREE.OrthographicCamera(
            -frustumSize * aspect / 2,
            frustumSize * aspect / 2,
            frustumSize / 2,
            -frustumSize / 2,
            0.1,
            1000
        );
        camera.position.set(2, 2, 3);
        camera.lookAt(0, 0, 0);
        
        // Renderer setup
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setClearColor(0x000000, 0); // Transparent background
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        
        const controls = new OrbitControls(camera, renderer.domElement);
        controls.target.set(0.5, 0.5, 0.5);
        controls.enablePan = false;
        controls.enableRotate = true;
        controls.enableZoom = false;
        controls.update();
        
        container.appendChild(renderer.domElement);
        
        // Get theme colors
        let themeColors = getThemeColors();

        // Bounding-box walls: gridded planes on all six sides of the unit cube.
        // Only the three walls facing away from the camera are shown each frame,
        // so the solid always sits in front of a gridded room corner.
        type WallAxis = 'x' | 'y' | 'z';
        type Wall = { axis: WallAxis; positive: boolean; grid: THREE.GridHelper };
        let walls: Wall[] = [];
        const buildWalls = () => {
            for (const wall of walls) {
                scene.remove(wall.grid);
                wall.grid.dispose();
            }
            walls = [];
            const defs: {
                axis: WallAxis;
                positive: boolean;
                position: [number, number, number];
                rotation: [number, number, number];
            }[] = [
                { axis: 'y', positive: false, position: [0.5, 0, 0.5], rotation: [0, 0, 0] },
                { axis: 'y', positive: true, position: [0.5, 1, 0.5], rotation: [0, 0, 0] },
                { axis: 'x', positive: false, position: [0, 0.5, 0.5], rotation: [0, 0, Math.PI / 2] },
                { axis: 'x', positive: true, position: [1, 0.5, 0.5], rotation: [0, 0, Math.PI / 2] },
                { axis: 'z', positive: false, position: [0.5, 0.5, 0], rotation: [Math.PI / 2, 0, 0] },
                { axis: 'z', positive: true, position: [0.5, 0.5, 1], rotation: [Math.PI / 2, 0, 0] },
            ];
            for (const def of defs) {
                const grid = new THREE.GridHelper(1, 10, themeColors.gridHelper, themeColors.grid);
                grid.position.set(...def.position);
                grid.rotation.set(...def.rotation);
                scene.add(grid);
                walls.push({ axis: def.axis, positive: def.positive, grid });
            }
        };
        buildWalls();

        // Flattened silhouettes of the machining window, one per axis, shown on
        // that axis' visible wall
        const projectionMaterial = new THREE.MeshBasicMaterial({
            color: 0x888888,
            transparent: true,
            opacity: 0.35,
            depthWrite: true,
            depthFunc: THREE.LessDepth, // flattened faces share a depth: draw each pixel once
            side: THREE.DoubleSide,
        });
        const projectionMeshes: Record<WallAxis, THREE.Mesh> = {
            x: new THREE.Mesh(new THREE.BufferGeometry(), projectionMaterial),
            y: new THREE.Mesh(new THREE.BufferGeometry(), projectionMaterial),
            z: new THREE.Mesh(new THREE.BufferGeometry(), projectionMaterial),
        };
        for (const mesh of Object.values(projectionMeshes)) {
            mesh.visible = false;
            scene.add(mesh);
        }

        // Axis lines with tick marks, drawn darker than the grid, along the same
        // front edges the labels sit on
        const axisLineMaterial = new THREE.LineBasicMaterial({ color: themeColors.axis });
        const TICK_VALUES = [0, 0.2, 0.4, 0.6, 0.8, 1];
        const TICK_LENGTH = 0.025;
        const buildAxisLine = (axis: WallAxis) => {
            const dir = { x: [1, 0, 0], y: [0, 1, 0], z: [0, 0, 1] }[axis];
            // Ticks extend outward in local +z (mirrored per frame), except the
            // z axis, whose ticks extend in local +x
            const tick = axis === 'z'
                ? new THREE.Vector3(TICK_LENGTH, 0, 0)
                : new THREE.Vector3(0, 0, TICK_LENGTH);
            const points: THREE.Vector3[] = [
                new THREE.Vector3(0, 0, 0),
                new THREE.Vector3(dir[0], dir[1], dir[2]),
            ];
            for (const value of TICK_VALUES) {
                const base = new THREE.Vector3(dir[0] * value, dir[1] * value, dir[2] * value);
                points.push(base, base.clone().add(tick));
            }
            const geometry = new THREE.BufferGeometry().setFromPoints(points);
            return new THREE.LineSegments(geometry, axisLineMaterial);
        };
        const axisLines: Record<WallAxis, THREE.LineSegments> = {
            x: buildAxisLine('x'),
            y: buildAxisLine('y'),
            z: buildAxisLine('z'),
        };
        for (const line of Object.values(axisLines)) {
            scene.add(line);
        }

        // A wall is a background wall when its outward normal points along the
        // view direction; each projection parks on its axis' background wall
        const viewDir = new THREE.Vector3();
        const WALL_OFFSET = 0.002;
        const updateBoxWalls = () => {
            camera.getWorldDirection(viewDir);
            const positiveVisible: Record<WallAxis, boolean> = {
                x: viewDir.x >= 0,
                y: viewDir.y >= 0,
                z: viewDir.z >= 0,
            };
            for (const wall of walls) {
                wall.grid.visible = wall.positive === positiveVisible[wall.axis];
            }
            projectionMeshes.x.position.x = positiveVisible.x ? 1 - WALL_OFFSET : WALL_OFFSET;
            projectionMeshes.y.position.y = positiveVisible.y ? 1 - WALL_OFFSET : WALL_OFFSET;
            projectionMeshes.z.position.z = positiveVisible.z ? 1 - WALL_OFFSET : WALL_OFFSET;

            // Park each axis label just outside the front edge of its visible
            // wall, so labels flip together with the walls
            const xVis = positiveVisible.x ? 1 : 0;
            const yVis = positiveVisible.y ? 1 : 0;
            const zVis = positiveVisible.z ? 1 : 0;
            const xNear = 1 - xVis;
            const zNear = 1 - zVis;
            const out = (edge: number, amount: number) => edge + (edge === 1 ? amount : -amount);
            placeLabel(hLabelEl, 0.5, yVis, out(zNear, 0.16));
            placeLabel(bLabelEl, out(xNear, 0.16), yVis, 0.5);
            placeLabel(vLabelEl, out(xVis, 0.1), 0.5, out(zNear, 0.1));

            // Axis lines hug the same edges; mirror so ticks point outward
            axisLines.x.position.set(0, yVis, zNear);
            axisLines.x.scale.z = zNear === 1 ? 1 : -1;
            axisLines.z.position.set(xNear, yVis, 0);
            axisLines.z.scale.x = xNear === 1 ? 1 : -1;
            axisLines.y.position.set(xVis, 0, zNear);
            axisLines.y.scale.z = zNear === 1 ? 1 : -1;

            const TICK_LABEL_OFFSET = 0.055;
            hTickEls.forEach((el, i) => placeLabel(el, TICK_VALUES[i], yVis, out(zNear, TICK_LABEL_OFFSET)));
            bTickEls.forEach((el, i) => placeLabel(el, out(xNear, TICK_LABEL_OFFSET), yVis, TICK_VALUES[i]));
            vTickEls.forEach((el, i) => placeLabel(el, out(xVis, 0.04), vTickValues[i], out(zNear, 0.04)));
        };
        
        // Materials
        //const surfaceMaterial = new THREE.MeshNormalMaterial({
        //    opacity: 0.5,
        //    transparent: true,
        //    side: THREE.DoubleSide
        //});

        const surfaceMaterial = new THREE.MeshMatcapMaterial({
            color: 0xffffff,
            opacity: 0.8,
            transparent: true,
            side: THREE.DoubleSide,
        });

        // Same look, but tinted per-face by the active limit
        const limitSurfaceMaterial = new THREE.MeshMatcapMaterial({
            color: 0xffffff,
            vertexColors: true,
            opacity: 0.8,
            transparent: true,
            side: THREE.DoubleSide,
        });

        
        
        // Axis labels: HTML overlay elements projected from 3D anchor points each
        // frame — crisp site typography, theme styling via classes
        const createOverlayLabel = (text: string, className = 'font-serif italic text-xl text-black dark:text-white') => {
            const el = document.createElement('div');
            el.className = `absolute pointer-events-none select-none -translate-x-1/2 -translate-y-1/2 ${className}`;
            el.textContent = text;
            container.appendChild(el);
            return el;
        };
        const vLabelEl = createOverlayLabel('v');
        const hLabelEl = createOverlayLabel('h');
        const bLabelEl = createOverlayLabel('b');

        // Numeric tick labels; the v axis skips 0 to avoid stacking on the
        // corner it shares with the h axis
        const tickLabelClass = 'font-sans text-xs text-gray-600 dark:text-gray-400';
        const hTickEls = TICK_VALUES.map((value) => createOverlayLabel(String(value), tickLabelClass));
        const bTickEls = TICK_VALUES.map((value) => createOverlayLabel(String(value), tickLabelClass));
        const vTickValues = TICK_VALUES.slice(1);
        const vTickEls = vTickValues.map((value) => createOverlayLabel(String(value), tickLabelClass));

        const labelWorldPos = new THREE.Vector3();
        const placeLabel = (el: HTMLDivElement, x: number, y: number, z: number) => {
            labelWorldPos.set(x, y, z).project(camera);
            el.style.left = `${(labelWorldPos.x * 0.5 + 0.5) * container.clientWidth}px`;
            el.style.top = `${(-labelWorldPos.y * 0.5 + 0.5) * container.clientHeight}px`;
        };
        
        // Function to update theme colors dynamically
        const updateThemeColors = () => {
            themeColors = getThemeColors();
            
            // Rebuild box walls with the new grid colors
            buildWalls();
            axisLineMaterial.color.setHex(themeColors.axis);

            // Re-tint surface colors for the new theme
            if (activeGhostLimit) {
                ghostMaterial.color.set(limitColor(activeGhostLimit));
            }
            Generate();
        };
        
        // Taylor surface
        const taylorSurfaceFn = (x: number, z: number) => {
            return CTVB * Math.pow(vb, n) / (Math.pow(z, q) * Math.pow(x, p) * Math.pow(T, m));
        };

        // Kienzle surface
        const kienzleSurfaceFn = (x: number, z: number) => {
            // Example Kienzle formula: y = ks11 * P * Math.pow(x, m) * Math.pow(z, n)
            // Adjust the formula as needed for your use case
            return P * 60 / (ks11 * x*Math.pow(z, 1-z_kienzle));
        };

        // vmax limit plane
        const vmaxPlaneFn = (_x: number, _z: number) => {
            return vmax;
        };

        // Ghost preview: while a slider is held, the full, unclipped constraint
        // surface it controls is shown transparently in its limit color.
        const ghostMaterial = new THREE.MeshMatcapMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.3,
            side: THREE.DoubleSide,
            depthWrite: false,
        });

        // Taylor/Kienzle blow up near x=0 or z=0; cap the ghost so it stays in view
        const GHOST_Y_CLAMP = 1.5;
        const surfaceGhostGeometry = (fn: (x: number, z: number) => number) => {
            const segments = 48;
            const geometry = new THREE.PlaneGeometry(1, 1, segments, segments);
            geometry.rotateX(-Math.PI / 2);
            geometry.translate(0.5, 0, 0.5);
            const pos = geometry.getAttribute('position');
            for (let i = 0; i < pos.count; i++) {
                pos.setY(i, Math.min(fn(pos.getX(i), pos.getZ(i)), GHOST_Y_CLAMP));
            }
            geometry.computeVertexNormals();
            return geometry;
        };
        const planeGhostGeometry = (y: number) => {
            const geometry = new THREE.PlaneGeometry(1, 1);
            geometry.rotateX(-Math.PI / 2);
            geometry.translate(0.5, y, 0.5);
            return geometry;
        };
        const hPlaneGhostGeometry = (x: number) => {
            const geometry = new THREE.PlaneGeometry(1, 1);
            geometry.rotateY(Math.PI / 2);
            geometry.translate(x, 0.5, 0.5);
            return geometry;
        };
        const bPlaneGhostGeometry = (z: number) => {
            const geometry = new THREE.PlaneGeometry(1, 1);
            geometry.translate(0.5, 0.5, z);
            return geometry;
        };
        const bhGhostGeometry = (bh: number) => {
            // Vertical plane through the origin along the b/h ratio line
            const ex = bh > 0.5 ? (1 - bh) * 2 : 1;
            const ez = bh < 0.5 ? bh * 2 : 1;
            const geometry = new THREE.BufferGeometry().setFromPoints([
                new THREE.Vector3(0, 0, 0), new THREE.Vector3(ex, 0, ez), new THREE.Vector3(ex, 1, ez),
                new THREE.Vector3(0, 0, 0), new THREE.Vector3(ex, 1, ez), new THREE.Vector3(0, 1, 0),
            ]);
            geometry.computeVertexNormals();
            return geometry;
        };

        let ghostMesh: THREE.Mesh | null = null;
        let activeGhostBuilder: (() => THREE.BufferGeometry) | null = null;
        let activeGhostLimit: LimitName | null = null;

        const updateGhost = () => {
            if (ghostMesh) {
                scene.remove(ghostMesh);
                ghostMesh.geometry.dispose();
                ghostMesh = null;
            }
            if (activeGhostBuilder) {
                ghostMesh = new THREE.Mesh(activeGhostBuilder(), ghostMaterial);
                scene.add(ghostMesh);
            }
        };
        const hideGhost = () => {
            activeGhostBuilder = null;
            activeGhostLimit = null;
            updateGhost();
        };
        const attachGhost = (
            elements: { slider: HTMLInputElement },
            limit: LimitName,
            builder: () => THREE.BufferGeometry
        ) => {
            elements.slider.addEventListener('pointerdown', () => {
                activeGhostBuilder = builder;
                activeGhostLimit = limit;
                ghostMaterial.color.set(limitColor(limit));
                updateGhost();
            });
            elements.slider.addEventListener('pointerup', hideGhost);
            elements.slider.addEventListener('pointercancel', hideGhost);
            elements.slider.addEventListener('change', hideGhost);
        };

        attachGhost(TSlider, 'taylor', () => surfaceGhostGeometry(taylorSurfaceFn));
        attachGhost(PSlider, 'kienzle', () => surfaceGhostGeometry(kienzleSurfaceFn));
        attachGhost(zkienzleSlider, 'kienzle', () => surfaceGhostGeometry(kienzleSurfaceFn));
        attachGhost(vminSlider, 'v', () => planeGhostGeometry(vmin));
        attachGhost(vmaxSlider, 'v', () => planeGhostGeometry(vmax));
        attachGhost(bhminSlider, 'bh', () => bhGhostGeometry(bhmin));
        attachGhost(bhmaxSlider, 'bh', () => bhGhostGeometry(bhmax));
        attachGhost(hminSlider, 'h', () => hPlaneGhostGeometry(hmin));
        attachGhost(hmaxSlider, 'h', () => hPlaneGhostGeometry(hmax));
        attachGhost(bminSlider, 'b', () => bPlaneGhostGeometry(bmin));
        attachGhost(bmaxSlider, 'b', () => bPlaneGhostGeometry(bmax));

        // Hover tooltip: raycast the pointer against the machining window and show
        // the legend entry of the limit surface under the cursor
        let hoverTargetMesh: THREE.Mesh | null = null;

        const tooltip = document.createElement('div');
        tooltip.className = 'absolute hidden pointer-events-none z-10 flex items-center gap-1.5 px-2 py-1 rounded text-xs bg-white/90 dark:bg-gray-800/90 border border-gray-300 dark:border-gray-600';
        const tooltipSwatch = document.createElement('span');
        tooltipSwatch.className = 'inline-block w-3 h-3 rounded-sm shrink-0';
        const tooltipText = document.createElement('span');
        tooltip.appendChild(tooltipSwatch);
        tooltip.appendChild(tooltipText);
        container.appendChild(tooltip);

        const hideTooltip = () => tooltip.classList.add('hidden');

        const raycaster = new THREE.Raycaster();
        const pointerNDC = new THREE.Vector2();
        const handlePointerMove = (event: PointerEvent) => {
            // Don't fight with orbit rotation
            if (!hoverTargetMesh || event.buttons !== 0) {
                hideTooltip();
                return;
            }
            const rect = renderer.domElement.getBoundingClientRect();
            pointerNDC.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            pointerNDC.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(pointerNDC, camera);
            const hit = raycaster.intersectObject(hoverTargetMesh, false)[0];
            const faceLimits = hoverTargetMesh.geometry.userData.faceLimits as LimitName[] | undefined;
            if (hit && hit.faceIndex != null && faceLimits && faceLimits[hit.faceIndex]) {
                const limit = faceLimits[hit.faceIndex];
                tooltipSwatch.style.background = limitColor(limit);
                tooltipText.textContent = LIMIT_COLORS[limit].label;
                tooltip.style.left = `${event.clientX - rect.left + 14}px`;
                tooltip.style.top = `${event.clientY - rect.top + 14}px`;
                tooltip.classList.remove('hidden');
            } else {
                hideTooltip();
            }
        };
        renderer.domElement.addEventListener('pointermove', handlePointerMove);
        renderer.domElement.addEventListener('pointerleave', hideTooltip);

        // Cached BSP trees for the CSG booleans — building these dominates the
        // cost of Generate(), and most sliders only invalidate one of them.
        let volumeCSGCache: { key: string; csg: CSG } | null = null;
        let boxCSGCache: { key: string; csg: CSG } | null = null;
        let prismCSGCache: { key: string; csg: CSG } | null = null;
        let volumeBoxCSGCache: { key: string; csg: CSG } | null = null;

        const FINAL_SEGMENTS = 50;

        const Generate = (segments: number = FINAL_SEGMENTS) => {
            // Remove old surface from scene and free its GPU buffers
            hoverTargetMesh = null;
            for (let obj of objects) {
                scene.remove(obj);
                if (obj instanceof THREE.Mesh || obj instanceof THREE.Line) {
                    obj.geometry.dispose();
                }
            }
            objects.length = 0; // Clear the array
            
            // b/h max line endpoints (used to build the prism cut below)
            const bhmaxPoints = [];
            bhmaxPoints.push(new THREE.Vector3(0, 0, 0));
            if (bhmax > 0.5) {
                bhmaxPoints.push(new THREE.Vector3((1-bhmax)*2, 0, 1));
            } else if (bhmax < 0.5) {
                bhmaxPoints.push(new THREE.Vector3(1, 0, (bhmax)*2));
            } else {
                bhmaxPoints.push(new THREE.Vector3(1, 0, 1));
            }

            // b/h min line endpoints (used to build the prism cut below)
            const bhminPoints = [];
            bhminPoints.push(new THREE.Vector3(0, 0, 0));
            if (bhmin > 0.5) {
                bhminPoints.push(new THREE.Vector3((1-bhmin)*2, 0, 1));
            } else if (bhmin < 0.5) {
                bhminPoints.push(new THREE.Vector3(1, 0, (bhmin)*2));
            } else {
                bhminPoints.push(new THREE.Vector3(1, 0, 1));
            }

            // Use ExtrudeGeometry for the prism between bhmin and bhmax

            // Define the 2D shape for extrusion (in x-z plane)
            const prismShape = new THREE.Shape();
            prismShape.moveTo(bhminPoints[0].x*2, bhminPoints[0].z*2);
            prismShape.lineTo(bhminPoints[1].x*2, bhminPoints[1].z*2);
            prismShape.lineTo(bhmaxPoints[1].x*2, bhmaxPoints[1].z*2);
            prismShape.lineTo(bhmaxPoints[0].x*2, bhmaxPoints[0].z*2);
            prismShape.lineTo(bhminPoints[0].x*2, bhminPoints[0].z*2); // Close the shape

            // Extrude settings: height = 1 (from y=0 to y=1)
            const extrudeSettings = {
                steps: 1,
                depth: -1,
                bevelEnabled: false,
                curveSegments: 1
            };

            // Extrude along the y-axis
            const prismGeometry = new THREE.ExtrudeGeometry(prismShape, extrudeSettings);

            // Move the geometry so its base is at y=0
            prismGeometry.rotateX(Math.PI / 2);
            prismGeometry.computeVertexNormals();

            const prismMesh = new THREE.Mesh(prismGeometry, surfaceMaterial);
            objects.push(prismMesh);
            scene.add(prismMesh);

            // Combine into a mesh: at each (x, z), y = max(vminPlane, min(taylorSurface, kienzleSurface))
            function combinedSurfaceFn(x: number, z: number) {
                const taylorY = taylorSurfaceFn(x, z);
                const kienzleY = kienzleSurfaceFn(x, z);
                const vminY = vmaxPlaneFn(x, z);
                return Math.min(taylorY, kienzleY, vminY);
            }

            // Decide which constraint a face of the CSG result belongs to, from its
            // orientation and centroid:
            // - downward faces are the v min cut, near-vertical axis-aligned walls are
            //   the h/b box cuts, other near-vertical walls are the slanted b/h prism cut
            // - the remaining (top) faces take whichever of Taylor / Kienzle / v max is
            //   lowest at the centroid, since the top surface is the min of the three
            const classifyFace = (cx: number, cz: number, normal: THREE.Vector3): LimitName => {
                if (normal.y <= -0.5) return 'v';
                if (Math.abs(normal.y) < 0.05) {
                    if (Math.abs(normal.x) > 0.99) return 'h';
                    if (Math.abs(normal.z) > 0.99) return 'b';
                    return 'bh';
                }
                const taylorY = taylorSurfaceFn(cx, cz);
                const kienzleY = kienzleSurfaceFn(cx, cz);
                if (vmax <= taylorY && vmax <= kienzleY) return 'v';
                return taylorY <= kienzleY ? 'taylor' : 'kienzle';
            };

            // Paint each face of the result with the color of its active limit, and
            // record the per-triangle limit for hover lookups
            const colorizeByLimit = (geometry: THREE.BufferGeometry): THREE.BufferGeometry => {
                const geo = geometry.index ? geometry.toNonIndexed() : geometry;
                const faceLimits: LimitName[] = [];
                const pos = geo.getAttribute('position');
                const colors = new Float32Array(pos.count * 3);
                const pA = new THREE.Vector3();
                const pB = new THREE.Vector3();
                const pC = new THREE.Vector3();
                const cb = new THREE.Vector3();
                const ab = new THREE.Vector3();
                const faceColor = new THREE.Color();
                for (let i = 0; i < pos.count; i += 3) {
                    pA.fromBufferAttribute(pos, i);
                    pB.fromBufferAttribute(pos, i + 1);
                    pC.fromBufferAttribute(pos, i + 2);
                    cb.subVectors(pC, pB);
                    ab.subVectors(pA, pB);
                    cb.cross(ab).normalize();
                    const cx = (pA.x + pB.x + pC.x) / 3;
                    const cz = (pA.z + pB.z + pC.z) / 3;
                    const limit = classifyFace(cx, cz, cb);
                    faceLimits.push(limit);
                    faceColor.set(limitColor(limit));
                    for (let j = 0; j < 3; j++) {
                        colors[(i + j) * 3] = faceColor.r;
                        colors[(i + j) * 3 + 1] = faceColor.g;
                        colors[(i + j) * 3 + 2] = faceColor.b;
                    }
                }
                geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
                geo.userData.faceLimits = faceLimits;
                return geo;
            };

            // Create a mesh from the base plane (y=0) up to the combined surface
            function createVolumeMesh(surfaceFn: (x: number, z: number) => number) {
                const geometry = new THREE.BufferGeometry();
                const positions = [];
                const normals = [];
                const indices = [];

                // Top surface (combined)
                for (let i = 0; i <= segments; i++) {
                    for (let j = 0; j <= segments; j++) {
                        const x = i / segments;
                        const z = j / segments;
                        const y = surfaceFn(x, z);
                        positions.push(x, y, z);
                        normals.push(0, 1, 0); // Approximate normal
                    }
                }
                // Bottom surface (y=0)
                for (let i = 0; i <= segments; i++) {
                    for (let j = 0; j <= segments; j++) {
                        const x = i / segments;
                        const z = j / segments;
                        positions.push(x, 0, z);
                        normals.push(0, -1, 0);
                    }
                }

                // Top surface indices
                for (let i = 0; i < segments; i++) {
                    for (let j = 0; j < segments; j++) {
                        const a = i * (segments + 1) + j;
                        const b = a + 1;
                        const c = a + (segments + 1);
                        const d = c + 1;
                        indices.push(a, b, d);
                        indices.push(a, d, c);
                    }
                }
                // Bottom surface indices (reverse order for correct normal)
                const offset = (segments + 1) * (segments + 1);
                for (let i = 0; i < segments; i++) {
                    for (let j = 0; j < segments; j++) {
                        const a = offset + i * (segments + 1) + j;
                        const b = a + 1;
                        const c = a + (segments + 1);
                        const d = c + 1;
                        indices.push(a, d, b);
                        indices.push(a, c, d);
                    }
                }
                // Side faces
                for (let i = 0; i < segments; i++) {
                    // z=0 edge
                    let topA = i * (segments + 1);
                    let topB = (i + 1) * (segments + 1);
                    let botA = offset + i * (segments + 1);
                    let botB = offset + (i + 1) * (segments + 1);
                    indices.push(topA, botB, botA);
                    indices.push(topA, topB, botB);

                    // z=segments edge
                    topA = i * (segments + 1) + segments;
                    topB = (i + 1) * (segments + 1) + segments;
                    botA = offset + i * (segments + 1) + segments;
                    botB = offset + (i + 1) * (segments + 1) + segments;
                    indices.push(topA, botA, botB);
                    indices.push(topA, botB, topB);
                }
                for (let j = 0; j < segments; j++) {
                    // x=0 edge
                    let topA = j;
                    let topB = j + 1;
                    let botA = offset + j;
                    let botB = offset + j + 1;
                    indices.push(topA, botA, botB);
                    indices.push(topA, botB, topB);

                    // x=segments edge
                    topA = segments * (segments + 1) + j;
                    topB = segments * (segments + 1) + j + 1;
                    botA = offset + segments * (segments + 1) + j;
                    botB = offset + segments * (segments + 1) + j + 1;
                    indices.push(topA, botB, botA);
                    indices.push(topA, topB, botB);
                }

                geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
                geometry.setAttribute('normal', new THREE.Float32BufferAttribute(normals, 3));
                geometry.setIndex(indices);

                geometry.computeVertexNormals();

                return new THREE.Mesh(geometry, surfaceMaterial);
            }

            const volumeMesh = createVolumeMesh(combinedSurfaceFn);
            objects.push(volumeMesh);
            scene.add(volumeMesh);
            // Create box geometry with limits in x (hmin, hmax) and z (bmin, bmax)
            const boxWidth = hmax - hmin;
            const boxHeight = vmax - vmin;
            const boxDepth = bmax - bmin;
            const boxGeometry = new THREE.BoxGeometry(boxWidth, boxHeight, boxDepth);

            // Center the box at the middle of the limits
            const boxMesh = new THREE.Mesh(boxGeometry, surfaceMaterial);
            boxMesh.position.set(
                hmin + boxWidth / 2,
                vmin + boxHeight / 2,
                bmin + boxDepth / 2
            );
            boxMesh.updateMatrix();
            objects.push(boxMesh);
            scene.add(boxMesh);

            // Boolean intersection (conjunction) of volumeMesh and boxMesh
            // Using ThreeCSG for mesh boolean operations

            try {
                // Convert meshes to CSG, reusing cached BSP trees whose inputs haven't changed
                const volumeKey = [segments, T, vb, p, q, m, n, CTVB, P, ks11, z_kienzle, vmax].join('|');
                const boxKey = [hmin, hmax, vmin, vmax, bmin, bmax].join('|');
                const prismKey = [bhmin, bhmax].join('|');

                if (!volumeCSGCache || volumeCSGCache.key !== volumeKey) {
                    volumeCSGCache = { key: volumeKey, csg: CSG.fromMesh(volumeMesh) };
                }
                if (!boxCSGCache || boxCSGCache.key !== boxKey) {
                    boxCSGCache = { key: boxKey, csg: CSG.fromMesh(boxMesh) };
                }
                if (!prismCSGCache || prismCSGCache.key !== prismKey) {
                    prismCSGCache = { key: prismKey, csg: CSG.fromMesh(prismMesh) };
                }

                // Perform intersection: volume ∩ box ∩ prism
                const volumeBoxKey = `${volumeKey}||${boxKey}`;
                if (!volumeBoxCSGCache || volumeBoxCSGCache.key !== volumeBoxKey) {
                    volumeBoxCSGCache = {
                        key: volumeBoxKey,
                        csg: volumeCSGCache.csg.intersect(boxCSGCache.csg)
                    };
                }
                const intersectCSG = volumeBoxCSGCache.csg.subtract(prismCSGCache.csg);

                // Create mesh from result, colored per-face by the active limit
                const rawMesh = CSG.toMesh(intersectCSG, volumeMesh.matrix, limitSurfaceMaterial);
                const coloredGeometry = colorizeByLimit(rawMesh.geometry);
                if (coloredGeometry !== rawMesh.geometry) {
                    rawMesh.geometry.dispose();
                }
                const intersectMesh = new THREE.Mesh(coloredGeometry, limitSurfaceMaterial);
                objects.push(intersectMesh);
                scene.add(intersectMesh);
                hoverTargetMesh = intersectMesh;

                // Refresh the wall projections: the solid flattened along each axis
                (['x', 'y', 'z'] as const).forEach((axis, axisIndex) => {
                    const src = coloredGeometry.getAttribute('position');
                    const flat = new Float32Array(src.array);
                    for (let i = axisIndex; i < flat.length; i += 3) {
                        flat[i] = 0;
                    }
                    const geo = new THREE.BufferGeometry();
                    geo.setAttribute('position', new THREE.BufferAttribute(flat, 3));
                    projectionMeshes[axis].geometry.dispose();
                    projectionMeshes[axis].geometry = geo;
                    projectionMeshes[axis].visible = true;
                });

                // Optionally hide original meshes
                volumeMesh.visible = false;
                boxMesh.visible = false;
                prismMesh.visible = false;
            } catch (err) {
                console.warn('CSG intersection failed:', err);
                for (const mesh of Object.values(projectionMeshes)) {
                    mesh.visible = false;
                }
            }
        };
        
        // While a slider is being dragged, regenerate at most once per frame at a
        // coarser resolution, then refine to full resolution once input settles.
        const INTERACTIVE_SEGMENTS = 20;
        let generateQueued = false;
        let refineTimeout: ReturnType<typeof setTimeout> | undefined;
        const requestGenerate = () => {
            updateGhost();
            clearTimeout(refineTimeout);
            refineTimeout = setTimeout(() => Generate(FINAL_SEGMENTS), 200);
            if (generateQueued) return;
            generateQueued = true;
            requestAnimationFrame(() => {
                generateQueued = false;
                Generate(INTERACTIVE_SEGMENTS);
            });
        };

        // Initial generation
        Generate();
        
        // Animation loop
        let animationId: number;
        const animate = () => {
            animationId = requestAnimationFrame(animate);
            updateBoxWalls();
            renderer.render(scene, camera);
        };
        
        // Handle window resize
        const handleResize = () => {
            if (!container) return;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        };
        
        window.addEventListener('resize', handleResize);
        
        // Listen for theme changes
        const themeObserver = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    updateThemeColors();
                }
            });
        });
        themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class']
        });
        
        // Start animation
        animate();
        
        // Cleanup function
        return () => {
            if (animationId) {
                cancelAnimationFrame(animationId);
            }
            clearTimeout(refineTimeout);
            window.removeEventListener('resize', handleResize);
            themeObserver.disconnect();
            if (container && renderer.domElement) {
                container.removeChild(renderer.domElement);
            }
            renderer.dispose();
        };
    }
    
    // Initialize when DOM is loaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMachiningWindow);
    } else {
        initMachiningWindow();
    }
</script>

