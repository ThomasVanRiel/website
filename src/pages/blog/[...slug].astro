---
import { getCollection } from "astro:content"

// Legacy redirect: /blog/<slug> -> /en/articles/<slug>
export async function getStaticPaths() {
  const items = await getCollection("articles")
  return items
    .filter((e) => (e.data.lang ?? "en") === "en")
    .map((e) => ({ params: { slug: e.id } }))
}

return Astro.redirect(`/en/articles/${Astro.params.slug}`, 301)
---
