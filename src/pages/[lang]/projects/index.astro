---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Projects from "@components/Projects"
import { LANGS, type Lang, useTranslations } from "@lib/i18n"
import { getLocalizedEntries, toCardEntry } from "@lib/content"

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useTranslations(lang)

const projects = (await getLocalizedEntries("projects", lang))
  .filter((p) => !p.entry.data.draft)
  .sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime())
  .map(toCardEntry)

const tags = [...new Set(projects.flatMap((project) => project.data.tags))]
  .sort((a, b) => a.localeCompare(b))
---

<PageLayout lang={lang} title={t.pages.projects.title} description={t.pages.projects.description}>
  <TopLayout>
    <div class="animate page-heading">
      {t.pages.projects.title}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Projects client:load tags={tags} data={projects} lang={lang} />
    </div>
  </BottomLayout>
</PageLayout>
