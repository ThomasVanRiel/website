---
import { join } from "node:path"
import { fileURLToPath } from "node:url"
import { type CollectionEntry, getCollection } from "astro:content"
import sharp from "sharp"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"
import Lightbox from "@components/Lightbox.astro"
import { LANGS, type Lang } from "@lib/i18n"
import { SITE } from "@consts"

const publicDir = fileURLToPath(new URL("../../../../public", import.meta.url))

const THUMB_WIDTHS = [480, 720, 1080, 1440]
const LIGHTBOX_WIDTH = 1800

export async function getStaticPaths() {
  const photos = await getCollection("photography")
  return LANGS.flatMap((lang) =>
    photos.map((photo) => ({
      params: { lang, slug: photo.slug },
      props: photo,
    }))
  )
}

type Props = CollectionEntry<"photography">
const lang = Astro.params.lang as Lang
const photo = Astro.props
const { title, summary, photos, license, date } = photo.data

function thumbUrl(slug: string, src: string, width: number) {
  const stem = src.replace(/\.[^.]+$/, "")
  return `/photography/${slug}/thumbs/${width}/${stem}.webp`
}

const gallery = await Promise.all(
  photos.map(async ({ src, alt }) => {
    const originalPath = join(publicDir, "photography", photo.slug, src)
    const meta = await sharp(originalPath).metadata()
    const swap = (meta.orientation ?? 1) >= 5
    const width = (swap ? meta.height : meta.width) ?? 1
    const height = (swap ? meta.width : meta.height) ?? 1
    const largeWidth = Math.min(width, LIGHTBOX_WIDTH)
    const largeHeight = Math.round((largeWidth * height) / width)
    const fullSrc = `/photography/${photo.slug}/${src}`
    const largeSrc = thumbUrl(photo.slug, src, LIGHTBOX_WIDTH)
    const defaultSrc = thumbUrl(photo.slug, src, THUMB_WIDTHS[THUMB_WIDTHS.length - 1])
    const srcset = THUMB_WIDTHS.map((w) => `${thumbUrl(photo.slug, src, w)} ${w}w`).join(", ")
    return { alt, width, height, largeWidth, largeHeight, largeSrc, fullSrc, defaultSrc, srcset }
  })
)

const LICENSE_URLS: Record<string, string> = {
  "CC BY 4.0": "https://creativecommons.org/licenses/by/4.0/",
  "CC BY-SA 4.0": "https://creativecommons.org/licenses/by-sa/4.0/",
  "CC BY-NC 4.0": "https://creativecommons.org/licenses/by-nc/4.0/",
  "CC BY-ND 4.0": "https://creativecommons.org/licenses/by-nd/4.0/",
  "CC BY-NC-SA 4.0": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  "CC BY-NC-ND 4.0": "https://creativecommons.org/licenses/by-nc-nd/4.0/",
  "CC0 1.0": "https://creativecommons.org/publicdomain/zero/1.0/",
}
const licenseUrl = LICENSE_URLS[license]

const author = { "@type": "Person", name: SITE.AUTHOR }
const copyrightNotice = `© ${date.getFullYear()} ${SITE.AUTHOR}`
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  datePublished: date.toISOString(),
  author,
  creator: author,
  copyrightHolder: author,
  copyrightNotice,
  ...(licenseUrl ? { license: licenseUrl } : {}),
  image: gallery.map(({ alt, largeSrc, largeWidth, largeHeight }) => ({
    "@type": "ImageObject",
    contentUrl: new URL(largeSrc, Astro.site).href,
    width: largeWidth,
    height: largeHeight,
    name: alt,
    description: alt,
    creditText: SITE.AUTHOR,
    creator: author,
    copyrightHolder: author,
    copyrightNotice,
    ...(licenseUrl
      ? { license: licenseUrl, acquireLicensePage: licenseUrl }
      : {}),
  })),
}
---

<PageLayout lang={lang} title={title} description={summary}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <TopLayout size="2xl">
    <div class="animate">
      <ArticleTopLayout entry={photo} lang={lang} />
    </div>
  </TopLayout>
  <BottomLayout size="2xl">
    <div class="animate">
      {gallery.length > 0 && (
        <div class="photo-grid mb-4">
          {gallery.map(({ alt, width, height, defaultSrc, srcset, largeSrc, fullSrc }) => {
            const ar = width / height
            const span = Math.max(1, Math.round(30 / ar))
            return (
              <a
                href={largeSrc}
                class="photo-cell"
                style={`grid-row: span ${span}`}
                data-w={width}
                data-h={height}
                data-full={fullSrc}
                aria-label={`Open ${alt}`}
              >
                <img
                  src={defaultSrc}
                  srcset={srcset}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 700px"
                  alt={alt}
                  width={width}
                  height={height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )
          })}
        </div>
      )}
      <p class="text-sm opacity-75 mb-8">
        © {date.getFullYear()} {SITE.AUTHOR} ·
        {licenseUrl ? (
          <> Licensed under <a rel="license" href={licenseUrl} target="_blank" class="underline hover:opacity-100">{license}</a></>
        ) : (
          <> {license}</>
        )}
      </p>
      <ArticleBottomLayout entry={photo} lang={lang} />
    </div>
  </BottomLayout>
</PageLayout>

<Lightbox license={license} licenseUrl={licenseUrl} />

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    grid-auto-rows: 8px;
    gap: 12px;
  }
  .photo-cell {
    overflow: hidden;
    border-radius: 0.5rem;
    background: rgba(0, 0, 0, 0.05);
    display: block;
  }
  :global(.dark) .photo-cell {
    background: rgba(255, 255, 255, 0.05);
  }
  .photo-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
    transition: transform 200ms ease;
  }
  .photo-cell:hover img {
    transform: scale(1.03);
  }
</style>

<script>
  function tightenGrid() {
    const grid = document.querySelector<HTMLElement>(".photo-grid")
    if (!grid) return
    const styles = getComputedStyle(grid)
    const rowHeight = parseFloat(styles.gridAutoRows) || 8
    const gap = parseFloat(styles.rowGap) || 0
    grid.querySelectorAll<HTMLElement>(".photo-cell").forEach((cell) => {
      const w = parseFloat(cell.dataset.w || "1")
      const h = parseFloat(cell.dataset.h || "1")
      const colWidth = cell.getBoundingClientRect().width
      if (!colWidth) return
      const tileHeight = colWidth * (h / w)
      const span = Math.max(1, Math.round((tileHeight + gap) / (rowHeight + gap)))
      cell.style.gridRow = `span ${span}`
    })
  }

  let raf: number | null = null
  function schedule() {
    if (raf) cancelAnimationFrame(raf)
    raf = requestAnimationFrame(tightenGrid)
  }

  function init() {
    tightenGrid()
    document.querySelectorAll<HTMLImageElement>(".photo-cell img").forEach((img) => {
      if (img.complete) return
      img.addEventListener("load", schedule, { once: true })
    })
  }

  init()
  window.addEventListener("resize", schedule)
  document.addEventListener("astro:after-swap", init)
</script>
