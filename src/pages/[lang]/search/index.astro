---
import type { CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Search from "@components/Search"
import { LANGS, type Lang, useTranslations } from "@lib/i18n"
import { getLocalizedEntries, toCardEntry } from "@lib/content"

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useTranslations(lang)

const posts = (await getLocalizedEntries("articles", lang))
  .filter((p) => !p.entry.data.draft)
  .map(toCardEntry)

const projects = (await getLocalizedEntries("projects", lang))
  .filter((p) => !p.entry.data.draft)
  .map(toCardEntry)

const data = [...posts, ...projects] as CollectionEntry<"articles">[]
---

<PageLayout lang={lang} title={t.pages.search.title} description={t.pages.search.description}>
  <TopLayout>
    <div class="animate page-heading">
      {t.pages.search.title}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} lang={lang} />
    </div>
  </BottomLayout>
</PageLayout>
