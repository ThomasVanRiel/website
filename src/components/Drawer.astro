---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
import { DEFAULT_LANG, type Lang, useTranslations, localizePath, switchLocalePath, stripLang } from "@lib/i18n"

const { lang = DEFAULT_LANG } = Astro.props as { lang?: Lang }
const t = useTranslations(lang)
const { pathname } = Astro.url
const bare = stripLang(pathname)
const bareTop = "/" + (bare.split("/")[1] ?? "")
const isActive = (href: string) => bare === href || bareTop === href
const otherLang: Lang = lang === "en" ? "nl" : "en"
const langSwitchHref = switchLocalePath(pathname, otherLang)
---

<div id="drawer" class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col items-center justify-center md:hidden bg-brand-lt dark:bg-brand-dk transition-[height] duration-100 ease-in-out">
  <nav class="flex flex-col items-center space-y-2">
    {
      LINKS.map((LINK) => (
        <a href={localizePath(LINK.HREF, lang)} class={cn("flex items-center justify-center px-3 py-1 rounded", "text-current hover:text-black dark:hover:text-white", "hover:bg-brand-dk/5 dark:hover:bg-brand-lt/20", "transition-colors duration-100 ease-in-out", isActive(LINK.HREF) ? "pointer-events-none bg-brand-dk dark:bg-brand-lt text-white dark:text-black" : "")}>
          {t.nav[LINK.KEY]}
        </a>
      ))
    }
  </nav>

  <div class="flex gap-1 mt-5">
    <a href={localizePath("/search", lang)} aria-label={t.aria.search(SITE.TITLE)} class={cn("size-9 rounded-full p-2 items-center justify-center bg-transparent hover:bg-brand-dk/5 dark:hover:bg-brand-lt/20 stroke-current hover:stroke-black hover:dark:stroke-white border border-black/10 dark:border-white/25 transition-colors duration-100 ease-in-out", isActive("/search") ? "pointer-events-none bg-brand-dk dark:bg-brand-lt text-white dark:text-black" : "")}>
      <svg class="size-full">
        <use href="/ui.svg#search"></use>
      </svg>
    </a>

    <a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label={t.aria.rss(SITE.TITLE)} class="size-9 rounded-full p-2 items-center justify-center bg-transparent hover:bg-brand-dk/5 dark:hover:bg-brand-lt/20 stroke-current hover:stroke-black hover:dark:stroke-white border border-black/10 dark:border-white/25 transition-colors duration-100 ease-in-out">
      <svg class="size-full">
        <use href="/ui.svg#rss"></use>
      </svg>
    </a>

    <a href={langSwitchHref} aria-label={t.aria.changeLanguage} class="size-9 rounded-full p-2 flex items-center justify-center text-sm font-semibold uppercase bg-transparent hover:bg-brand-dk/5 dark:hover:bg-brand-lt/20 hover:text-black hover:dark:text-white border border-black/10 dark:border-white/25 transition-colors duration-100 ease-in-out">
      {otherLang}
    </a>

    <button id="drawer-theme-button" aria-label={t.aria.toggleTheme} class="size-9 rounded-full p-2 items-center justify-center bg-transparent hover:bg-brand-dk/5 dark:hover:bg-brand-lt/20 stroke-current hover:stroke-black hover:dark:stroke-white border border-black/10 dark:border-white/25 transition-colors duration-100 ease-in-out">
      <svg class="block dark:hidden size-full">
        <use href="/ui.svg#sun"></use>
      </svg>
      <svg class="hidden dark:block size-full">
        <use href="/ui.svg#moon"></use>
      </svg>
    </button>
  </div>
</div>

<style>
  #drawer.open {
    @apply h-full;
  }
</style>
