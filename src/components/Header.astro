---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
import { DEFAULT_LANG, type Lang, useTranslations, localizePath, switchLocalePath, stripLang } from "@lib/i18n"
import Container from "@components/Container.astro"

const { lang = DEFAULT_LANG } = Astro.props as { lang?: Lang }
const t = useTranslations(lang)
const { pathname } = Astro.url
const bare = stripLang(pathname)
const bareTop = "/" + (bare.split("/")[1] ?? "")
const isActive = (href: string) => bare === href || bareTop === href
const otherLang: Lang = lang === "en" ? "nl" : "en"
const langSwitchHref = switchLocalePath(pathname, otherLang)
---

<header id="header" class="fixed top-0 w-full h-16 z-50 ">
  <Container size="md">
    <div class="relative h-full w-full">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 flex gap-1 font-serif text-2xl">
        <a href={localizePath("/", lang)} class="flex gap-1 text-current hover:text-brand-lt-hover dark:hover:text-brand-dk-hover transition-colors duration-100 ease-in-out">
          <div>
            {SITE.TITLE}
          </div>
        </a>
      </div>

    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <nav class="hidden md:flex items-center justify-center text-sm gap-1">
        {
          LINKS.map((LINK) => (
            <a href={localizePath(LINK.HREF, lang)} class={cn("h-8 rounded px-3 text-current ", "flex items-center justify-center", "transition-colors duration-100 ease-in-out", isActive(LINK.HREF) ? "button-invert text-white dark:text-black" : "hover:bg-black/5 dark:hover:bg-white/20 hover:text-black dark:hover:text-white")}>
              {t.nav[LINK.KEY]}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-1">
      <a href={localizePath("/search", lang)} aria-label={t.aria.search(SITE.TITLE)} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-black/5 dark:hover:bg-white/20", "stroke-current hover:stroke-black hover:dark:stroke-white", "border border-black/10 dark:border-white/25", "transition-colors duration-100 ease-in-out", isActive("/search") ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black" : "")}>
        <svg class="size-full">
          <use href="/ui.svg#search"></use>
        </svg>
      </a>

      <a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label={t.aria.rss(SITE.TITLE)} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-black/5 dark:hover:bg-white/20", "stroke-current hover:stroke-black hover:dark:stroke-white", "border border-black/10 dark:border-white/25", "transition-colors duration-100 ease-in-out")}>
        <svg class="size-full">
          <use href="/ui.svg#rss"></use>
        </svg>
      </a>

      <a href={langSwitchHref} aria-label={t.aria.changeLanguage} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center text-sm uppercase", "bg-transparent hover:bg-black/5 dark:hover:bg-white/20", "hover:text-black hover:dark:text-white", "border border-black/10 dark:border-white/25", "transition-colors duration-100 ease-in-out")}>
        {otherLang}
      </a>

      <button id="header-theme-button" aria-label={t.aria.toggleTheme} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-black/5 dark:hover:bg-white/20", "stroke-current hover:stroke-black hover:dark:stroke-white", "border border-black/10 dark:border-white/25", "transition-colors duration-100 ease-in-out")}>
        <svg class="size-full block dark:hidden">
          <use href="/ui.svg#sun"></use>
        </svg>
        <svg class="size-full hidden dark:block">
          <use href="/ui.svg#moon"></use>
        </svg>
      </button>

      <button id="header-drawer-button" aria-label={t.aria.toggleDrawer} class={cn("flex md:hidden", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-black/5 dark:hover:bg-white/20", "stroke-current hover:stroke-black hover:dark:stroke-white", "border border-black/10 dark:border-white/25", "transition-colors duration-100 ease-in-out")}>
        <svg id="drawer-open" class="size-full">
          <use href="/ui.svg#menu"></use>
        </svg>
        <svg id="drawer-close" class="size-full">
          <use href="/ui.svg#x"></use>
        </svg>
      </button>
    </div>
  </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script is:inline>
  function toggleDrawer() {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.classList.toggle("open")
    drawerButton?.classList.toggle("open")
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", toggleDrawer)
  }

  document.addEventListener("astro:after-swap", initializeDrawerButton)
  initializeDrawerButton()
</script>
