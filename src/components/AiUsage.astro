---
import AiBadge from "@components/AiBadge"
import { cn } from "@lib/utils"
import { AI_CATEGORIES, AI_SHARES, type AiUsage } from "@lib/ai"
import { DEFAULT_LANG, type Lang, useTranslations, localizePath } from "@lib/i18n"

type Props = {
  ai: AiUsage
  lang?: Lang
}

const { ai, lang = DEFAULT_LANG } = Astro.props
const t = useTranslations(lang)
const categories = AI_CATEGORIES.flatMap((category) => {
  const share = ai.usage?.[category]
  return share ? [{ category, share, filled: AI_SHARES.indexOf(share) }] : []
})
---

<aside class="mt-6 p-4 text-sm rounded-lg border border-black/15 dark:border-white/20">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="font-semibold uppercase text-black dark:text-white">
      {t.ai.heading}
    </div>
    <AiBadge level={ai.level} lang={lang} />
  </div>
  <p class="mt-2">
    {t.ai.level[ai.level].description}
  </p>
  {categories.length > 0 && (
    <dl class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3">
      {categories.map(({ category, share, filled }) => (
        <div>
          <dt class="text-xs uppercase opacity-75">
            {t.ai.category[category]}
          </dt>
          <dd class="flex items-center gap-1.5">
            <span class="flex gap-0.5" aria-hidden="true">
              {[1, 2].map((dot) => (
                <span class={cn("size-1.5 rounded-full bg-current", dot > filled && "opacity-25")} />
              ))}
            </span>
            {t.ai.share[share]}
          </dd>
        </div>
      ))}
    </dl>
  )}
  {ai.note && (
    <p class="mt-3">
      {ai.note}
    </p>
  )}
  <a href={localizePath("/legal/ai-manifesto", lang)} class="mt-3 inline-block underline decoration-[.5px] underline-offset-2 decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white blend">
    {t.ai.manifesto}
  </a>
</aside>
