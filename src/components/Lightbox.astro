---
---

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <button class="lightbox-btn lightbox-close" aria-label="Close" data-action="close">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
  <button class="lightbox-btn lightbox-prev" aria-label="Previous" data-action="prev">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </button>
  <figure class="lightbox-stage">
    <img class="lightbox-img" alt="" />
    <img class="lightbox-qr" src="/qr.svg" alt="" aria-hidden="true" />
  </figure>
  <button class="lightbox-btn lightbox-next" aria-label="Next" data-action="next">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  </button>
</dialog>

<style>
  .lightbox {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    color: white;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-stage {
    position: relative;
    display: inline-block;
    margin: 0;
    line-height: 0;
  }
  .lightbox-img {
    display: block;
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    user-select: none;
  }
  .lightbox-qr {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: 10%;
    min-width: 80px;
    max-width: 140px;
    aspect-ratio: 1 / 1;
    display: block;
    pointer-events: none;
  }
  .lightbox-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    border: none;
    border-radius: 9999px;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms ease;
  }
  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  type LightboxState = {
    docClick?: (e: MouseEvent) => void
    docKey?: (e: KeyboardEvent) => void
  }
  const state: LightboxState = ((window as unknown as { __lb?: LightboxState }).__lb ??= {})

  function init() {
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null
    if (!dialog) return
    const img = dialog.querySelector(".lightbox-img") as HTMLImageElement
    let index = 0

    const cells = () => Array.from(document.querySelectorAll<HTMLAnchorElement>("a.photo-cell"))

    function show(i: number) {
      const list = cells()
      if (!list.length) return
      index = (i + list.length) % list.length
      const cell = list[index]
      img.src = cell.href
      const inner = cell.querySelector("img")
      img.alt = inner?.alt ?? ""
    }

    if (state.docClick) document.removeEventListener("click", state.docClick)
    if (state.docKey) document.removeEventListener("keydown", state.docKey)

    state.docClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null
      const cell = target?.closest<HTMLAnchorElement>("a.photo-cell")
      if (cell) {
        e.preventDefault()
        const list = cells()
        show(list.indexOf(cell))
        if (!dialog.open) dialog.showModal()
      }
    }
    state.docKey = (e: KeyboardEvent) => {
      if (!dialog.open) return
      if (e.key === "ArrowLeft") show(index - 1)
      else if (e.key === "ArrowRight") show(index + 1)
    }
    document.addEventListener("click", state.docClick)
    document.addEventListener("keydown", state.docKey)

    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement
      const action = (target.closest("[data-action]") as HTMLElement | null)?.dataset.action
      if (action === "close") dialog.close()
      else if (action === "prev") show(index - 1)
      else if (action === "next") show(index + 1)
      else if (target === dialog) dialog.close()
    })
  }

  init()
  document.addEventListener("astro:after-swap", init)
</script>
