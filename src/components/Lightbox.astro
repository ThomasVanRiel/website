---
interface Props {
  license?: string
  licenseUrl?: string
}
const { license, licenseUrl } = Astro.props
---

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <button class="lightbox-btn lightbox-close" aria-label="Close" data-action="close">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
  <button class="lightbox-btn lightbox-prev" aria-label="Previous" data-action="prev">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </button>
  <figure class="lightbox-stage">
    <img class="lightbox-img" alt="" />
    <div class="lightbox-meta">
      <span class="lightbox-alt"></span>
      <a class="lightbox-download" href="#" download hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>Download original</span>
      </a>
      <span class="lightbox-license">
        {license && licenseUrl ? (
          <a rel="license" href={licenseUrl} target="_blank">{license}</a>
        ) : license ?? ""}
      </span>
    </div>
  </figure>
  <button class="lightbox-btn lightbox-next" aria-label="Next" data-action="next">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  </button>
</dialog>

<style>
  .lightbox {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    color: white;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-stage {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    margin: 0;
    max-width: 95vw;
  }
  .lightbox-img {
    align-self: center;
    max-width: 95vw;
    max-height: calc(95vh - 56px);
    object-fit: contain;
    border-radius: 6px;
    user-select: none;
    display: block;
  }
  .lightbox-meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .lightbox-alt {
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .lightbox-license {
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .lightbox-license a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .lightbox-license a:hover {
    text-decoration-color: rgba(255, 255, 255, 1);
  }
  .lightbox-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    border: none;
    border-radius: 9999px;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms ease;
  }
  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-download {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    text-decoration: none;
    transition: background 150ms ease;
  }
  .lightbox-download:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox-download[hidden] {
    display: none;
  }
</style>

<script>
  type LightboxState = {
    docClick?: (e: MouseEvent) => void
    docKey?: (e: KeyboardEvent) => void
  }
  const state: LightboxState = ((window as unknown as { __lb?: LightboxState }).__lb ??= {})

  function init() {
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null
    if (!dialog) return
    const img = dialog.querySelector(".lightbox-img") as HTMLImageElement
    const download = dialog.querySelector(".lightbox-download") as HTMLAnchorElement
    const altLabel = dialog.querySelector(".lightbox-alt") as HTMLElement
    let index = 0

    const cells = () => Array.from(document.querySelectorAll<HTMLAnchorElement>("a.photo-cell"))

    function show(i: number) {
      const list = cells()
      if (!list.length) return
      index = (i + list.length) % list.length
      const cell = list[index]
      img.src = cell.href
      const inner = cell.querySelector("img")
      const altText = inner?.alt ?? ""
      img.alt = altText
      altLabel.textContent = altText
      const full = cell.dataset.full
      if (full) {
        download.href = full
        download.hidden = false
      } else {
        download.removeAttribute("href")
        download.hidden = true
      }
    }

    if (state.docClick) document.removeEventListener("click", state.docClick)
    if (state.docKey) document.removeEventListener("keydown", state.docKey)

    state.docClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null
      const cell = target?.closest<HTMLAnchorElement>("a.photo-cell")
      if (cell) {
        e.preventDefault()
        const list = cells()
        show(list.indexOf(cell))
        if (!dialog.open) dialog.showModal()
      }
    }
    state.docKey = (e: KeyboardEvent) => {
      if (!dialog.open) return
      if (e.key === "ArrowLeft") show(index - 1)
      else if (e.key === "ArrowRight") show(index + 1)
    }
    document.addEventListener("click", state.docClick)
    document.addEventListener("keydown", state.docKey)

    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement
      const action = (target.closest("[data-action]") as HTMLElement | null)?.dataset.action
      if (action === "close") dialog.close()
      else if (action === "prev") show(index - 1)
      else if (action === "next") show(index + 1)
      else if (target === dialog) dialog.close()
    })
  }

  init()
  document.addEventListener("astro:after-swap", init)
</script>
